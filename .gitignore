# Secrets: the real config.json contains the playlist URL with a subscription token
config.json

# Build/deploy artifacts
build.zip
*.zip
install_resp.html
resp_shot.txt
*.log

# Generated EPG data (published to the epg-data branch, not committed to main)
epg/epg.json
epg/*.xml
epg/*.xml.gz

# Python
__pycache__/
*.pyc

# OS / editor cruft
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/
*.swp

# Personal registry seed: the owner's own favourites list, restored into the TV after
# an install clears the registry. It ships in the build (tar takes source/ from disk)
# but must never reach this public repo -- it is a personal viewing list, the same
# reason channel names were stripped from the repo in TASK-15. A clone without it
# degrades correctly: RestoreStoreIfEmpty finds no file and does nothing.
source/restore.json

# Local agent state and isolated working trees
.agent-memory/
.worktrees/

# Favorites/recents captured from the TV before each sideload (contains channel names)
backups/
