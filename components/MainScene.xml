<?xml version="1.0" encoding="utf-8" ?>
<component name="MainScene" extends="Scene">
    <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />
    <script type="text/brightscript" uri="pkg:/source/Theme.brs" />
    <children>
        <Timer id="epgRefreshTimer" duration="3600" repeat="true" />
        <Timer id="nowTimer" duration="30" repeat="true" />
        <Rectangle id="background" width="1920" height="1080" color="0x0E1310FF">
            <!-- Loading state -->
            <!-- Not a BusySpinner. A bare one draws nothing (it renders a `poster` it
                 does not have), and attaching one via role="poster" changed nothing on
                 this device and logged nothing either. Built from primitives instead,
                 so a failure is diagnosable: if the ring appears but does not turn, the
                 Animation is wrong; if nothing appears, the image path is.
                 rotation is in RADIANS, and pivots on scaleRotateCenter = the centre. -->
            <Group id="spinner" translation="[900, 424]" visible="true">
                <Poster id="loadSpinnerImg"
                        uri="pkg:/images/spinner.png"
                        width="120" height="120"
                        scaleRotateCenter="[60, 60]" />
                <Animation id="loadSpinnerAnim" duration="1.1" repeat="true" easeFunction="linear">
                    <FloatFieldInterpolator key="[0.0, 1.0]"
                                            keyValue="[0.0, 6.28318]"
                                            fieldToInterp="loadSpinnerImg.rotation" />
                </Animation>
            </Group>
            <Label id="statusLabel"
                   text="Loading…"
                   color="0x8A968EFF"
                   translation="[0, 560]"
                   width="1920"
                   horizAlign="center"
                   visible="true" />
            
            <!-- Error state -->
            <Label id="errorLabel"
                   text=""
                   color="0xECF2EEFF"
                   translation="[0, 480]"
                   width="1920"
                   horizAlign="center"
                   visible="false" />
            <Label id="errorHintLabel"
                   text="Press OK to retry"
                   color="0x8A968EFF"
                   translation="[0, 540]"
                   width="1920"
                   horizAlign="center"
                   visible="false" />
                   
            <!-- Splash branding (visible on loading / error) -->
            <Group id="brandGroup" visible="true">
                <Label text="IPTV Player"
                       translation="[0, 330]"
                       color="0xECF2EEFF"
                       width="1920"
                       horizAlign="center" />
                <Rectangle translation="[890, 405]" width="140" height="4" color="0x4FB03AFF" />
                <!-- y=952, not 1000: at 1000 the ink ended 56px from the bottom
                     edge, inside the ~90px overscan zone. -->
                <Label text="(c) 2026 DimaKarma"
                       translation="[0, 952]"
                       color="0x8A968EFF"
                       width="1920"
                       horizAlign="center"
                       scale="[0.7,0.7]"
                       scaleRotateCenter="[960,0]" />
            </Group>
                   
            <!-- Main Content -->
            <ChannelsScreen id="channelsScreen" visible="false" />
            <PlayerScreen id="playerScreen" visible="false" />
            
            <!-- Search and Settings -->
            <SearchScreen id="searchScreen" visible="false" />
            <SettingsScreen id="settingsScreen" visible="false" />
            
            <!-- Onboarding -->
            <Group id="onboardingGroup" visible="false">
                <Label text="IPTV Player"
                       translation="[0, 200]"
                       color="0xECF2EEFF"
                       width="1920"
                       horizAlign="center" />
                <Keyboard id="onboardingKeyboard" translation="[700, 300]" />
                <Label text="Or set the URL in config.json and reinstall"
                       translation="[0, 800]"
                       color="0x8A968EFF"
                       width="1920"
                       horizAlign="center" />
                <Button id="onboardingOk"
                        text="Save and continue"
                        translation="[700, 700]" />
            </Group>
        </Rectangle>
    </children>
</component>
