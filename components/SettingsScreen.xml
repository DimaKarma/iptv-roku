<?xml version="1.0" encoding="utf-8" ?>
<component name="SettingsScreen" extends="Group">
    <script type="text/brightscript" uri="pkg:/components/SettingsScreen.brs" />
    <script type="text/brightscript" uri="pkg:/source/Theme.brs" />
    <script type="text/brightscript" uri="pkg:/source/ChannelStore.brs" />
    <interface>
        <field id="info" type="assocarray" onChange="onInfoChange" />
        <!-- action carries WHICH action; actionCommand is the trigger that fires it.
             A field observer only fires when the value CHANGES, so repeating the same
             action (Refresh, then Refresh again) would never reach MainScene if the
             string alone were observed. Same idiom as playCommand in PlayerScreen. -->
        <field id="action" type="string" />
        <field id="actionCommand" type="boolean" />
        <field id="newUrl" type="string" />
        <field id="notice" type="string" />
        <field id="noticeCommand" type="boolean" />
        <field id="exitRequested" type="boolean" />
    </interface>

    <children>
        <Label id="headerLabel"
               text="SETTINGS"
               translation="[96, 54]"
               color="0xDCE9EEFF"
               width="1700"
               height="40" />

        <!-- The third and last list on the stock grey chip. Fixing only the two the owner
             happened to look at would have left the same 1.29:1 defect one screen away. -->
        <LabelList id="settingsList"
                   translation="[96, 120]"
                   itemSize="[800, 70]"
                   itemSpacing="[0, 10]"
                   color="0x86A6B1FF"
                   focusedColor="0xFFFFFFFF"
                   focusBitmapBlendColor="0xFF4D1FFF"
                   numRows="7" />
                   
        <Label id="infoLabel"
               translation="[960, 120]"
               color="0x86A6B1FF"
               width="800"
               height="800"
               wrap="true" />
               
        <!-- Keyboard overlay. The keyboard's x is set at runtime (CenterKeyboard in
             init and again when shown): it is wider than the old x=700 allowed. Back from
             the keyboard moves focus to the Save / Cancel list; nothing is discarded by
             Back from the keyboard. The list is placed under the keyboard at runtime too,
             so its y below is only the fallback. Same chip mechanism as settingsList. -->
        <Rectangle id="keyboardBg"
                   width="1920" height="1080"
                   color="0x020B13E6"
                   visible="false">
            <Keyboard id="keyboard" translation="[274, 200]" />
            <Label id="keyboardHint"
                   text="Enter a new playlist URL"
                   translation="[0, 150]"
                   width="1920"
                   horizAlign="center"
                   color="0xDCE9EEFF" />
            <LabelList id="saveCancelList"
                       translation="[760, 560]"
                       itemSize="[400, 60]"
                       itemSpacing="[0, 10]"
                       color="0x86A6B1FF"
                       focusedColor="0xFFFFFFFF"
                       focusBitmapBlendColor="0xFF4D1FFF"
                       numRows="2" />
        </Rectangle>

        <!-- Toast -->
        <Rectangle id="toastBg"
                   translation="[460, 950]"
                   width="1000"
                   height="60"
                   color="0x062230FF"
                   visible="false">
            <Label id="toastLabel"
                   width="1000"
                   height="60"
                   horizAlign="center"
                   vertAlign="center"
                   color="0xDCE9EEFF" />
        </Rectangle>
        
        <Timer id="toastTimer" duration="2.5" repeat="false" />
    </children>
</component>
