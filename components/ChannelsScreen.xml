<?xml version="1.0" encoding="utf-8" ?>
<component name="ChannelsScreen" extends="Group">
    <script type="text/brightscript" uri="pkg:/components/ChannelsScreen.brs" />
    <script type="text/brightscript" uri="pkg:/source/Theme.brs" />
    <script type="text/brightscript" uri="pkg:/source/ChannelStore.brs" />
    <interface>
        <field id="playlistResult" type="assocarray" onChange="onPlaylistChange" />
        <field id="playRequest" type="assocarray" />
        <field id="restoreFocus" type="boolean" />
        <field id="openSearch" type="boolean" />
        <field id="openSettings" type="boolean" />
        <!-- notice carries the text, noticeCommand triggers it (repeat-safe). -->
        <field id="notice" type="string" />
        <field id="noticeCommand" type="boolean" />
    </interface>
    
    <children>
        <!-- Rail on the left -->
        <!-- focusBitmapBlendColor MULTIPLIES the stock focus bitmap. The stock chip is
             #D5D5D5, so 0x5FD345 lands on #4FB03A exactly - the brandbook green. Paired
             with on-accent text that is 6.86:1; off-white on the stock grey chip was
             1.29:1, and green-bright on it is 1.26:1, so deleting the runtime override
             instead of changing it would have been a regression. Blending only darkens,
             which is why the UNFOCUSED chip (a separate, darker #303531 footprint bitmap)
             cannot be tinted this way at all - that needs its own bitmap. -->
        <LabelList id="categoryList"
                   translation="[96, 54]"
                   itemSize="[380, 50]"
                   itemSpacing="[0, 10]"
                   color="0x8A968EFF"
                   focusedColor="0x08130AFF"
                   focusBitmapBlendColor="0x5FD345FF"
                   numRows="15" />
                   
        <!-- Header. x=530, not 500, and the grid below moves with it.
             The rail's focus chip is 380 wide by declaration but PAINTS to x=507 - the
             platform draws that bitmap ~32px past its item on each side. At 500 the
             header's first letter was drawn ON TOP of the chip's green, overlapping by up
             to 4 columns. 530 puts 24px of background between them, and the header keeps
             its left alignment with the first card column because the grid moves too:
             that alignment is what makes it read as a label FOR the grid. -->
        <Label id="headerLabel"
               translation="[530, 54]"
               color="0xECF2EEFF"
               width="1270"
               height="40" />
               
        <!-- Grid on the right -->
        <!-- The grid draws the focus ring itself, OUTSIDE the item and outside its own
             clip, so it is the only indicator that reaches all four sides of every cell
             including the edge columns. Stock is #E7E9E8; 0x57C140 multiplies to #4FB03A
             exactly. This also matches the brandbook, whose .card.focused is a box-shadow
             OUTSIDE the card - the card's own inner border was the thing moving away
             from it. -->
        <MarkupGrid id="channelGrid"
                    translation="[530, 114]"
                    itemComponentName="ChannelCard"
                    itemSize="[330, 220]"
                    itemSpacing="[12, 12]"
                    numColumns="4"
                    numRows="4"
                    focusBitmapBlendColor="0x57C140FF" />
                    
        <!-- Empty / Not Found Label -->
        <!-- Spans the grid exactly: 530 + 1356 = 1886, so horizAlign="center" centres on
             the grid's own centre. At [500,400] w1324 it centred on 1162 against the grid's
             1178 and had always been 16px out. -->
        <Label id="emptyLabel"
               translation="[530, 400]"
               width="1356"
               horizAlign="center"
               color="0x8A968EFF"
               text="Nothing found"
               visible="false" />
               
        <!-- Toast -->
        <!-- 990 + 60 high put the toast's bottom edge at 1050, i.e. 60px inside the
             overscan margin on a 1080 panel. -->
        <Rectangle id="toastBg"
                   translation="[460, 920]"
                   width="1000"
                   height="60"
                   color="0x18211CFF"
                   visible="false">
            <Label id="toastLabel"
                   width="1000"
                   height="60"
                   horizAlign="center"
                   vertAlign="center"
                   color="0xECF2EEFF" />
        </Rectangle>
        
        <Timer id="toastTimer" duration="2.5" repeat="false" />
        <Timer id="gridDebounceTimer" duration="0.12" repeat="false" />
        <Timer id="okTimer" duration="0.8" repeat="false" />
    </children>
</component>
