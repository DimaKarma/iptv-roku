<?xml version="1.0" encoding="utf-8" ?>
<component name="PlayerScreen" extends="Group">
    <script type="text/brightscript" uri="pkg:/components/PlayerScreen.brs" />
    <script type="text/brightscript" uri="pkg:/source/Theme.brs" />
    <script type="text/brightscript" uri="pkg:/source/ChannelStore.brs" />
    <script type="text/brightscript" uri="pkg:/source/Epg.brs" />
    <interface>
        <field id="playlist" type="array" />
        <field id="playCommand" type="boolean" onChange="onPlayCommand" />
        <field id="startIndex" type="integer" />
        <field id="exitRequested" type="boolean" />
    </interface>
    
    <children>
        <Video id="video"
               width="1920" height="1080"
               translation="[0, 0]"
               visible="true" />
               
        <!-- Spinner & Loading text -->
        <!-- Same construction as the loading screen; see MainScene.xml for why this is
             not a BusySpinner. Distinct node ids so a findNode from either component
             cannot reach into the other. -->
        <Group id="spinner" translation="[900, 424]" visible="false">
            <Poster id="playSpinnerImg"
                    uri="pkg:/images/spinner.png"
                    width="120" height="120"
                    scaleRotateCenter="[60, 60]" />
            <Animation id="playSpinnerAnim" duration="1.1" repeat="true" easeFunction="linear">
                <FloatFieldInterpolator key="[0.0, 1.0]"
                                        keyValue="[0.0, 6.28318]"
                                        fieldToInterp="playSpinnerImg.rotation" />
            </Animation>
        </Group>
        <Label id="loadingLabel"
               translation="[0, 560]"
               width="1920" horizAlign="center"
               color="0xECF2EEFF" visible="false" />
               
        <!-- Overlay (OK button) -->
        <!-- Anchored to the bottom edge, but 224 tall instead of 180 and starting
             56px higher, so the EPG row inside it ends 54px clear of the screen
             edge instead of 10px. At [0,900] that row sat inside the overscan
             zone - the one row carrying Now/Next was the likeliest to be cut off. -->
        <Rectangle id="overlayGroup"
                   width="1920" height="224"
                   translation="[0, 856]"
                   color="0x000000CC"
                   visible="false">
            <Label id="overlayName"
                   translation="[100, 30]"
                   width="1400" height="60"
                   color="0xECF2EEFF" />
            <Label id="overlayGroupLabel"
                   translation="[100, 100]"
                   width="1400" height="40"
                   color="0x8A968EFF" />
            <Label id="overlayTime"
                   translation="[1500, 30]"
                   width="300" height="60"
                   horizAlign="right"
                   color="0xECF2EEFF" />
            <Label id="overlayEpg"
                   translation="[100, 140]"
                   width="1720" height="30"
                   color="0x8A968EFF" text="" />
        </Rectangle>
        
        <!-- Mini-banner (Zap). Left-anchored on the app's x=96 spine: a centred
             label moves its left edge on every zap, so the eye has to re-find the
             start of the name while surfing.
             Layout closes exactly: 24+44+4+36+20+4 = 132 vertically,
             28+736+24+224+28 = 1040 horizontally.
             Row 2 carries the programme title when there is one and the channel's
             category when there is not - about two thirds of channels have no
             guide at all, so the empty state has to look deliberate, not degraded. -->
        <Rectangle id="miniBanner"
                   width="1040" height="132"
                   translation="[96, 856]"
                   color="0x0E1310E6"
                   visible="false">
            <!-- L-bracket, upright -->
            <Rectangle id="zapSpine"
                       width="4" height="132"
                       translation="[0, 0]"
                       color="0x4FB03AFF" />

            <Label id="miniBannerLabel"
                   translation="[28, 24]"
                   width="984" height="44"
                   horizAlign="left" vertAlign="center"
                   wrap="false"
                   color="0xECF2EEFF" />

            <Label id="zapLine2"
                   translation="[28, 72]"
                   width="736" height="36"
                   horizAlign="left" vertAlign="center"
                   wrap="false"
                   color="0xECF2EEFF" />

            <!-- Right-aligned, so the scale pivot is its RIGHT edge (224), not its
                 centre - pivoting at the centre would drift the shrunken text away
                 from the panel margin. -->
            <Label id="zapUntil"
                   translation="[788, 72]"
                   width="224" height="36"
                   horizAlign="right" vertAlign="center"
                   wrap="false"
                   scale="[0.8, 0.8]"
                   scaleRotateCenter="[224, 18]"
                   color="0x8A968EFF" />

            <!-- L-bracket, foot: elapsed fraction of the current programme. Flush
                 with the panel edge and with no track behind it, so when there is no
                 programme it leaves no hole - just a panel edge. -->
            <Rectangle id="zapProgress"
                       width="0" height="4"
                       translation="[0, 128]"
                       color="0x4FB03AFF"
                       visible="false" />
        </Rectangle>
        
        <!-- Error Dialog -->
        <Rectangle id="errorDialog"
                   width="800" height="470"
                   translation="[560, 305]"
                   color="0x18211CFF"
                   visible="false">
            <Label id="errorTitle"
                   text="Playback error"
                   translation="[0, 40]"
                   width="800" horizAlign="center"
                   color="0xECF2EEFF" />
            <Label id="errorMsg"
                   translation="[50, 120]"
                   width="700" height="80"
                   horizAlign="center" wrap="true"
                   color="0x8A968EFF" />
                   
            <LabelList id="errorOptions"
                       translation="[200, 220]"
                       itemSize="[400, 50]"
                       color="0x8A968EFF"
                       focusedColor="0x74D45BFF" />
        </Rectangle>
        
        <!-- Toast for favorites -->
        <!-- y 784..844: below the error dialog (ends 775, and the two do coexist -
             the dialog's favourite option raises a toast) and above the zap banner
             (starts 856). At the old y=800 it overlapped the banner by 4px. -->
        <Rectangle id="toastBg"
                   translation="[460, 784]"
                   width="1000" height="60"
                   color="0x18211CCC"
                   visible="false">
            <Label id="toastLabel"
                   width="1000" height="60"
                   horizAlign="center" vertAlign="center"
                   color="0xECF2EEFF" />
        </Rectangle>
        
        <Timer id="overlayTimer" duration="5.0" repeat="false" />
        <Timer id="miniBannerTimer" duration="3.0" repeat="false" />
        <Timer id="toastTimer" duration="2.5" repeat="false" />
        <Timer id="clockTimer" duration="30.0" repeat="true" />
        <Timer id="okTimer" duration="0.8" repeat="false" />
        
        <!-- Zapper panel (vertical list on the right) -->
        <Rectangle id="zapperPanel"
                   width="560" height="1080"
                   translation="[1360, 0]"
                   color="0x000000E6"
                   visible="false">
            <MarkupGrid id="zapperGrid"
                        translation="[20, 30]"
                        itemComponentName="ZapperCard"
                        itemSize="[520, 88]"
                        itemSpacing="[0, 8]"
                        numRows="11"
                        numColumns="1"
                        vertFocusAnimationStyle="floatingFocus"
                        drawFocusFeedback="false" />
        </Rectangle>
        <Timer id="zapperTimer" duration="5.0" repeat="false" />
    </children>
</component>
