<?xml version="1.0" encoding="utf-8" ?>
<component name="ZapperCard" extends="Group">
    <script type="text/brightscript" uri="pkg:/components/ZapperCard.brs" />
    <script type="text/brightscript" uri="pkg:/source/Theme.brs" />
    <script type="text/brightscript" uri="pkg:/source/Epg.brs" />
    
    <interface>
        <field id="itemContent" type="node" onChange="onContentChange" />
        <field id="focusPercent" type="float" onChange="onFocusChange" />
    </interface>
    
    <children>
        <!-- small colored initials tile on the left -->
        <Rectangle id="fallbackBg" width="72" height="72" translation="[8, 8]">
            <Label id="fallbackLabel" width="72" height="72" horizAlign="center" vertAlign="center" />
        </Rectangle>

        <Label id="nameLabel" translation="[92, 12]" width="384" height="34" wrap="false" />
        <Label id="epgLabel"  translation="[92, 48]" width="384" height="28" wrap="false" />

        <Label id="favStar" text="★" translation="[490, 10]" color="0x74D45BFF" visible="false" />
        <Rectangle id="badge" width="20" height="20" translation="[490, 50]" visible="false" />

        <!-- Focus border for the 520x88 row, INSIDE the row's own bounds.
             These were at [-4,-4] like ChannelCard's, and zapperGrid is numColumns="1",
             so every row is column 0 and the left rectangle fell outside the grid's
             viewport on EVERY row - not just the first. zapperGrid also carries
             drawFocusFeedback="false", so nothing was covering the loss. ZapperCard does
             not scale, so this is a plain offset with no scale arithmetic to satisfy. -->
        <Group id="focusBorder" visible="false">
            <Rectangle width="520" height="4" translation="[0, 0]" color="0x4FB03AFF" />
            <Rectangle width="520" height="4" translation="[0, 84]" color="0x4FB03AFF" />
            <Rectangle width="4" height="88" translation="[0, 0]" color="0x4FB03AFF" />
            <Rectangle width="4" height="88" translation="[516, 0]" color="0x4FB03AFF" />
        </Group>
    </children>
</component>
