<?xml version="1.0" encoding="utf-8" ?>
<component name="ChannelContent" extends="ContentNode">
    <interface>
        <field id="name" type="string" />
        <field id="url" type="string" />
        <field id="group" type="string" />
        <field id="logo" type="string" />
        <field id="compatible" type="boolean" />
        <field id="favorite" type="boolean" />
        <!-- Programme on now, computed when the grid is BUILT (one guide read per build) and
             refreshed on epgReady. ChannelCard only displays it. Empty when there is no guide. -->
        <field id="epgNow" type="string" />
    </interface>
</component>
