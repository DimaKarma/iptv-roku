<?xml version="1.0" encoding="utf-8" ?>
<component name="SearchScreen" extends="Group">
    <script type="text/brightscript" uri="pkg:/components/SearchScreen.brs" />
    <script type="text/brightscript" uri="pkg:/source/Theme.brs" />
    <script type="text/brightscript" uri="pkg:/source/ChannelStore.brs" />
    <script type="text/brightscript" uri="pkg:/source/Translit.brs" />
    <script type="text/brightscript" uri="pkg:/source/Epg.brs" />
    <interface>
        <field id="channels" type="array" onChange="onChannelsChange" />
        <field id="playRequest" type="assocarray" />
        <field id="exitRequested" type="boolean" />
        <!-- Toggled by MainScene when the player is left: focus goes to the card that
             was played. A toggle, because an observer only fires on CHANGE. -->
        <field id="restoreFocus" type="boolean" onChange="onRestoreFocus" />
    </interface>

    <children>
        <!-- The query field, 616 wide above the keyboard. It only DISPLAYS the query (m.query);
             this Group itself holds focus and handles every key, so nothing here is focusable. -->
        <Rectangle id="fieldBg"
                   translation="[96, 54]"
                   width="616"
                   height="64"
                   color="0x0E3442FF" />
        <Label id="fieldLabel"
               translation="[120, 54]"
               width="568"
               height="64"
               vertAlign="center"
               wrap="false"
               color="0x86A6B1FF"
               text="Type to search" />

        <Label id="headerLabel"
               translation="[760, 54]"
               color="0xDCE9EEFF"
               width="1014"
               height="64"
               vertAlign="center" />

        <!-- Hint under the keyboard. Smaller than the default font by scale only (rule 22):
             width 770 * 0.8 = 616 on screen. -->
        <Label id="hintLabel"
               translation="[96, 668]"
               width="770"
               height="45"
               vertAlign="center"
               wrap="false"
               scale="[0.8, 0.8]"
               scaleRotateCenter="[0, 0]"
               color="0x86A6B1FF"
               text="" />

        <Label id="statusLabel"
               translation="[760, 330]"
               width="1014"
               horizAlign="center"
               color="0x86A6B1FF"
               text="" />

        <!-- The own keyboard: 6 columns x 7 rows of 96x64 cells, gap 8, from x=96, y=140.
             The cells are created ONCE in init (rule 17). Draw order, bottom to top: key
             fills, the focus highlight, the active-layout bar, the way-back outline, key
             texts. The highlight, bar and outline are single nodes moved by translation. -->
        <Group id="keyBgs" />
        <Rectangle id="keyHighlight"
                   translation="[96, 140]"
                   width="96"
                   height="64"
                   color="0xD5401AFF"
                   visible="false" />
        <Rectangle id="activeBar"
                   translation="[408, 632]"
                   width="96"
                   height="4"
                   color="0x60BBD2FF" />
        <Group id="wayBack" translation="[96, 140]" visible="false">
            <Rectangle id="wayTop" translation="[0, 0]" width="96" height="4" color="0x86A6B1FF" />
            <Rectangle id="wayBottom" translation="[0, 60]" width="96" height="4" color="0x86A6B1FF" />
            <Rectangle id="wayLeft" translation="[0, 0]" width="4" height="64" color="0x86A6B1FF" />
            <Rectangle id="wayRight" translation="[92, 0]" width="4" height="64" color="0x86A6B1FF" />
        </Group>
        <Group id="keyLabels" />

        <!-- Same ChannelCard, so the same focus treatment: without the blend this screen
             would keep the stock white ring while the Channels grid went accent-coloured.
             Three columns from x=760: 760 + 3*330 + 2*12 = 1774. -->
        <MarkupGrid id="channelGrid"
                    translation="[760, 140]"
                    itemComponentName="ChannelCard"
                    itemSize="[330, 220]"
                    itemSpacing="[12, 12]"
                    numColumns="3"
                    numRows="3"
                    focusBitmapBlendColor="0xEB461DFF" />

        <!-- Toast -->
        <!-- 920, matching ChannelsScreen. At 950 the 60px-high toast ended at 1010,
             70px from the panel edge against a 90px advisory margin - the same defect
             T1-6 fixed on the other screen and did not sweep for here. -->
        <Rectangle id="toastBg"
                   translation="[460, 920]"
                   width="1000"
                   height="60"
                   color="0x062230FF"
                   visible="false">
            <Label id="toastLabel"
                   width="1000"
                   height="60"
                   horizAlign="center"
                   vertAlign="center"
                   color="0xDCE9EEFF" />
        </Rectangle>

        <Timer id="searchTimer" duration="0.3" repeat="false" />
        <Timer id="toastTimer" duration="2.5" repeat="false" />
    </children>
</component>
